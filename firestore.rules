rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection check route
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User documents
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // User lessons subcollection
      match /lessons/{lessonId} {
        allow read, write: if isOwner(userId) && isValidId(lessonId);
      }

      // User achievements subcollection
      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId) && isValidId(achievementId);
      }
    }
  }
}
