{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account details and role in the UDL lesson planner",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "school": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "LessonPlan": {
      "title": "LessonPlan",
      "description": "A Universal Design for Learning (UDL) lesson plan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "subject": { "type": "string" },
        "learningGoal": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "userId"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "Educator badge and milestone record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "unlockedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Collection of user profiles accessible by the owner"
    },
    "/users/{userId}/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/LessonPlan" },
      "description": "Lessons authored by a specific user"
    },
    "/users/{userId}/achievements/{achievementId}": {
      "schema": { "$ref": "#/entities/Achievement" },
      "description": "Achievements earned by a specific user"
    }
  }
}
